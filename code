import torch
import torch.nn as nn
import torch.optim as optim
from torch.optim import lr_scheduler
from torchvision import datasets, models, transforms
from PIL import Image

# Image size for VGG16
img_width, img_height = 224, 224

# Paths and parameters
train_folder = r"C:\Users\bhuva\Signature detection\Signature-detection-using-CNN\Signatures for CNN"
batch_size = 3
num_epochs = 9

# Data preprocessing and normalization
data_transforms = transforms.Compose([
    transforms.Resize((img_width, img_height)),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
])

# Load dataset and create dataloader
train_dataset = datasets.ImageFolder(train_folder, transform=data_transforms)
train_loader = torch.utils.data.DataLoader(train_dataset, batch_size=batch_size, shuffle=True)

# Load pretrained VGG16 and freeze features
from torchvision.models import VGG16_Weights
model = models.vgg16(weights=VGG16_Weights.IMAGENET1K_V1)
for param in model.features.parameters():
    param.requires_grad = False

# Replace final layer for our classes
num_ftrs = model.classifier[6].in_features
model.classifier[6] = nn.Linear(num_ftrs, len(train_dataset.classes))

# Loss, optimizer, and scheduler
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.classifier.parameters(), lr=0.001)
exp_lr_scheduler = lr_scheduler.StepLR(optimizer, step_size=7, gamma=0.1)

# Use GPU if available
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model.to(device)

# Training loop
for epoch in range(num_epochs):
    model.train()
    running_loss = 0.0
    for inputs, labels in train_loader:
        inputs, labels = inputs.to(device), labels.to(device)
        outputs = model(inputs)
        loss = criterion(outputs, labels)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        running_loss += loss.item() * inputs.size(0)
    exp_lr_scheduler.step()
    print(f"Epoch {epoch+1}/{num_epochs}, Loss: {running_loss/len(train_dataset):.4f}")

print("Training done.")

# Function to classify a single image
def classify_image(img_path):
    img = Image.open(img_path).convert('RGB')
    img = data_transforms(img).unsqueeze(0).to(device)
    with torch.no_grad():
        outputs = model(img)
        probs = nn.functional.softmax(outputs, dim=1)[0]
        _, preds = torch.max(outputs, 1)
    class_name = train_dataset.classes[preds.item()]
    probability = probs[preds.item()].item()
    print(f'Prediction: {class_name} ({probability*100:.2f}%)')

# Test example
img_path = r"C:\Users\bhuva\Signature detection\Signature-detection-using-CNN\testdata\Screenshot 2025-05-09 191537.png"
classify_image(img_path)
